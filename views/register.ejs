<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Daftar Admin - <%= appName %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-amber-50/50 min-h-screen flex items-center justify-center p-4">
    <div class="bg-white border border-amber-100 rounded-3xl shadow-xl w-full max-w-md p-8">
        <div class="text-center mb-6">
            <span class="text-4xl">🍛</span>
            <h1 class="text-2xl font-black text-gray-900 mt-2">Registrasi Admin</h1>
        </div>

        <% if (locals.error && error) { %>
            <div
                class="bg-rose-50 border border-rose-200 text-rose-700 text-xs font-semibold px-4 py-3 rounded-xl mb-5">
                ⚠️ <%= error %>
            </div>
            <% } %>

                <form action="/register" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Nama Lengkap</label>
                        <input type="text" name="nama_lengkap" required
                            class="w-full border border-gray-300 px-4 py-2.5 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Username</label>
                        <input type="text" name="username" required
                            class="w-full border border-gray-300 px-4 py-2.5 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Password</label>
                        <input type="password" name="password" required minlength="6"
                            class="w-full border border-gray-300 px-4 py-2.5 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Konfirmasi Password</label>
                        <input type="password" name="confirm_password" required minlength="6"
                            class="w-full border border-gray-300 px-4 py-2.5 rounded-xl text-sm focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    </div>
                    <button type="submit"
                        class="w-full bg-amber-600 hover:bg-amber-700 text-white font-bold py-3 rounded-xl text-sm shadow-md transition">Daftar</button>
                </form>

                <div class="mt-6 pt-5 border-t border-gray-100 text-center">
                    <p class="text-xs text-gray-600">Sudah punya akun? <a href="/login"
                            class="text-amber-700 font-bold hover:underline">Login</a></p>
                </div>
    </div>
</body>

</html>