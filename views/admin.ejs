<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Pengelola - <%= appName %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 text-gray-800 min-h-screen flex flex-col justify-between">

    <!-- Include Admin Header -->
    <%- include('components/header-admin') %>

        <main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full space-y-8">

            <!-- Statistik Ringkas -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
                <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Antrean Verifikasi Struk</p>
                    <p class="text-2xl font-black text-rose-600 mt-2">
                        <%= pesananMasuk %> Pesanan
                    </p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Pendapatan
                        Terverifikasi</p>
                    <p class="text-2xl font-black text-emerald-600 mt-2">
                        <%= formatRupiah(totalOmset) %>
                    </p>
                </div>
                <div class="bg-white p-5 rounded-2xl border border-gray-200 shadow-sm">
                    <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Menu Aktif</p>
                    <p class="text-2xl font-black text-amber-600 mt-2">
                        <%= produk.length %> Varian
                    </p>
                </div>
            </div>

            <!-- TABEL 1: ANTREAN RESERVASI -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
                    <div>
                        <h2 class="text-lg font-bold text-gray-900">Daftar Reservasi & Antrean Pesanan</h2>
                        <p class="text-xs text-gray-500 mt-0.5">Verifikasi bukti transfer pelanggan untuk memotong stok
                            dapur secara otomatis</p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-gray-50 text-gray-600 uppercase font-semibold border-b border-gray-200">
                            <tr>
                                <th class="px-5 py-3.5">Kode / Tgl</th>
                                <th class="px-5 py-3.5">Pelanggan & WA</th>
                                <th class="px-5 py-3.5">Jadwal Ambil</th>
                                <th class="px-5 py-3.5">Pesanan Item</th>
                                <th class="px-5 py-3.5">Total Bayar</th>
                                <th class="px-5 py-3.5">Bukti Transfer</th>
                                <th class="px-5 py-3.5">Status</th>
                                <th class="px-5 py-3.5 text-center">Aksi Verifikasi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <% if (pesanan && pesanan.length> 0) { %>
                                <% pesanan.forEach(p=> { %>
                                    <tr class="hover:bg-gray-50/80 transition">
                                        <td class="px-5 py-4 font-mono font-bold text-gray-900">
                                            <%= p.kode_pesanan %>
                                                <span class="block font-normal text-[10px] text-gray-400 mt-0.5">
                                                    <%= new Date(p.created_at).toLocaleDateString('id-ID') %>
                                                </span>
                                        </td>
                                        <td class="px-5 py-4">
                                            <p class="font-bold text-gray-900">
                                                <%= p.nama_pelanggan %>
                                            </p>
                                            <a href="https://wa.me/<%= p.nomor_wa.replace(/^0/, '62') %>"
                                                target="_blank"
                                                class="text-emerald-700 hover:underline flex items-center gap-1 mt-0.5">
                                                💬 <%= p.nomor_wa %>
                                            </a>
                                        </td>
                                        <td class="px-5 py-4 font-medium text-gray-700">
                                            <%= new Date(p.jadwal_pengambilan).toLocaleString('id-ID', {
                                                dateStyle: 'medium' , timeStyle: 'short' }) %> WIB
                                        </td>
                                        <td class="px-5 py-4 max-w-xs text-gray-600 truncate"
                                            title="<%= p.rincian_menu %>">
                                            <%= p.rincian_menu || '-' %>
                                        </td>
                                        <td class="px-5 py-4 font-bold text-amber-700">
                                            <%= formatRupiah(p.total_bayar) %>
                                        </td>
                                        <td class="px-5 py-4">
                                            <% if (p.bukti_transfer) { %>
                                                <button onclick="previewBukti('<%= p.bukti_transfer %>')"
                                                    class="px-2.5 py-1 bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold rounded-lg transition text-[11px]">
                                                    Lihat Struk
                                                </button>
                                                <% } else { %>
                                                    <span class="text-gray-400 italic">Tidak ada</span>
                                                    <% } %>
                                        </td>
                                        <td class="px-5 py-4">
                                            <% if (p.status==='Menunggu Verifikasi' ) { %>
                                                <span
                                                    class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full font-bold">Menunggu</span>
                                                <% } else if (p.status==='Diproses' ) { %>
                                                    <span
                                                        class="bg-blue-100 text-blue-800 px-2.5 py-1 rounded-full font-bold">Disiapkan</span>
                                                    <% } else if (p.status==='Selesai' ) { %>
                                                        <span
                                                            class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full font-bold">Selesai</span>
                                                        <% } else { %>
                                                            <span
                                                                class="bg-gray-100 text-gray-700 px-2.5 py-1 rounded-full font-bold">Batal</span>
                                                            <% } %>
                                        </td>
                                        <td class="px-5 py-4 text-center">
                                            <div class="inline-flex gap-1.5">
                                                <% if (p.status==='Menunggu Verifikasi' ) { %>
                                                    <button onclick="updateStatus('<%= p.id %>', 'Diproses')"
                                                        class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-[11px] transition shadow-sm">
                                                        Setujui
                                                    </button>
                                                    <button onclick="updateStatus('<%= p.id %>', 'Dibatalkan')"
                                                        class="px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-lg font-bold text-[11px] transition">
                                                        Tolak
                                                    </button>
                                                    <% } else if (p.status==='Diproses' ) { %>
                                                        <button onclick="updateStatus('<%= p.id %>', 'Selesai')"
                                                            class="px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-bold text-[11px] transition shadow-sm">
                                                            Selesaikan
                                                        </button>
                                                        <% } else { %>
                                                            <span class="text-gray-400 font-medium">-</span>
                                                            <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="8" class="px-6 py-8 text-center text-gray-400">Belum ada
                                                    pesanan masuk dari pembeli.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- TABEL 2: KELOLA DATA PRODUK -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div
                    class="px-6 py-5 border-b border-gray-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-gray-50/50">
                    <div>
                        <h2 class="text-lg font-bold text-gray-900">Katalog Menu & Ketersediaan Stok Porsi</h2>
                        <p class="text-xs text-gray-500 mt-0.5">Kelola porsi harian agar etalase pelanggan sinkron</p>
                    </div>
                    <button onclick="openModalCreate()"
                        class="bg-amber-600 hover:bg-amber-700 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-sm transition flex items-center gap-1.5">
                        <span>+</span> Tambah Menu Baru
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-gray-50 text-gray-600 uppercase font-semibold border-b border-gray-200">
                            <tr>
                                <th class="px-5 py-3.5">ID</th>
                                <th class="px-5 py-3.5">Nama Menu</th>
                                <th class="px-5 py-3.5">Harga</th>
                                <th class="px-5 py-3.5">Sisa Porsi</th>
                                <th class="px-5 py-3.5">Deskripsi</th>
                                <th class="px-5 py-3.5 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <% if (produk && produk.length> 0) { %>
                                <% produk.forEach(item=> { %>
                                    <tr class="hover:bg-gray-50/80 transition">
                                        <td class="px-5 py-4 font-mono text-gray-400">#<%= item.id %>
                                        </td>
                                        <td class="px-5 py-4 font-bold text-gray-900 flex items-center gap-2">
                                            <img src="<%= item.gambar_url || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100' %>"
                                                class="w-8 h-8 rounded-lg object-cover">
                                            <%= item.nama_produk %>
                                        </td>
                                        <td class="px-5 py-4 font-bold text-amber-700">
                                            <%= formatRupiah(item.harga) %>
                                        </td>
                                        <td class="px-5 py-4">
                                            <% if (item.stok> 0) { %>
                                                <span
                                                    class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold">
                                                    <%= item.stok %> porsi
                                                </span>
                                                <% } else { %>
                                                    <span
                                                        class="bg-rose-100 text-rose-800 px-2 py-0.5 rounded-full font-bold">
                                                        Habis
                                                    </span>
                                                    <% } %>
                                        </td>
                                        <td class="px-5 py-4 text-gray-500 max-w-xs truncate">
                                            <%= item.deskripsi || '-' %>
                                        </td>
                                        <td class="px-5 py-4 text-center">
                                            <div class="inline-flex gap-2">
                                                <button type="button" data-id="<%= item.id %>"
                                                    data-nama="<%= item.nama_produk %>" data-harga="<%= item.harga %>"
                                                    data-stok="<%= item.stok %>"
                                                    data-deskripsi="<%= item.deskripsi || '' %>"
                                                    data-gambar="<%= item.gambar_url || '' %>"
                                                    onclick="handleEditClick(this)"
                                                    class="px-2.5 py-1 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg font-bold transition">
                                                    Ubah
                                                </button>
                                                <button type="button" onclick="deleteProduct('<%= item.id %>')"
                                                    class="px-2.5 py-1 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded-lg font-bold transition">
                                                    Hapus
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>

        <!-- Include Modals & Footer -->
        <%- include('components/modal-product') %>
            <%- include('components/modal-preview') %>
                <%- include('components/footer') %>

                    <!-- External Admin JS -->
                    <script src="/js/admin.js"></script>
</body>

</html>