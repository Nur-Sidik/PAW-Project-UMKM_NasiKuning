<header class="bg-amber-400 py-5 px-6 shadow-sm sticky top-0 z-40">
    <div class="max-w-6xl mx-auto flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-black text-amber-950 tracking-tight flex items-center gap-2">
                <span>🍛</span>
                <%= appName %>
            </h1>
            <p class="text-amber-900 font-medium text-xs mt-0.5">Sistem Pemesanan Sarapan & Katering Porsi Praktis</p>
        </div>

        <div class="flex items-center gap-3">
            <button onclick="openCartModal()"
                class="relative bg-amber-500 hover:bg-amber-600 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-sm flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
                Keranjang
                <span id="cartCountBadge"
                    class="bg-rose-600 text-white text-[10px] px-1.5 py-0.5 rounded-full font-bold ml-1 hidden">0</span>
            </button>

            <a href="/admin" class="text-xs text-amber-900 hover:text-black font-semibold px-2 py-1 transition">
                Portal Mitra &rarr;
            </a>
        </div>
    </div>
</header>