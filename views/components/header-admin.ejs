<header class="bg-gray-900 text-white shadow-md sticky top-0 z-30">
  <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
    <!-- Sisi Kiri: Branding Panel -->
    <div class="flex items-center gap-3">
      <span class="bg-amber-500 text-gray-900 font-black px-2.5 py-1 rounded-md text-xs uppercase tracking-wider">
        Owner / Dapur
      </span>
      <h1 class="text-lg font-bold tracking-tight"><%= appName %> Panel</h1>
    </div>

    <!-- Sisi Kanan: Info Admin, Navigasi & Tombol Logout -->
    <div class="flex items-center gap-3">
      <span class="text-xs text-gray-300 hidden sm:inline">
        Halo, <strong class="text-amber-400"><%= locals.admin && admin.nama ? admin.nama : 'Admin' %></strong>
      </span>

      <a href="/" class="text-xs bg-gray-800 hover:bg-gray-700 text-gray-200 px-3.5 py-2 rounded-xl border border-gray-700 transition font-medium">
        &larr; Halaman Pelanggan
      </a>

      <a href="/logout" 
         onclick="return confirm('Yakin ingin keluar dari panel admin?')"
         class="text-xs bg-rose-600 hover:bg-rose-700 text-white font-bold px-3.5 py-2 rounded-xl shadow-sm transition flex items-center gap-1.5">
         Logout
      </a>
    </div>
  </div>
</header>