<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= appName %> - Pesan Sarapan & Katering Online
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-amber-50/40 text-gray-800 min-h-screen flex flex-col justify-between">

    <!-- Include Header -->
    <%- include('components/header-pelanggan') %>

        <!-- Main Content: Katalog Menu -->
        <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">
            <div
                class="bg-gradient-to-r from-amber-500 to-amber-600 rounded-3xl p-6 sm:p-8 text-white shadow-md mb-10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
                <div class="max-w-xl">
                    <span
                        class="bg-white/20 text-white text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Pesan
                        Sekarang &bull; Ambil Pagi</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold mt-3 leading-tight">Sarapan Nasi Kuning Hangat Tanpa
                        Antre</h2>
                    <p class="text-amber-100 text-sm mt-2">Pilih menu, tentukan jadwal pengambilan, bayar transfer/QRIS,
                        dan porsi siap dibawa.</p>
                </div>
                <div class="bg-white/10 backdrop-blur-md border border-white/20 p-4 rounded-2xl text-xs space-y-1">
                    <p class="font-bold text-amber-100 uppercase tracking-wider">Jam Buka Dapur:</p>
                    <p class="text-white">Senin - Minggu: 06.00 - 11.00 WIB</p>
                </div>
            </div>

            <div class="mb-6">
                <h3 class="text-2xl font-bold text-gray-900">Daftar Pilihan Menu</h3>
                <p class="text-sm text-gray-500 mt-1">Stok porsi terpantau secara real-time langsung dari dapur</p>
            </div>

            <!-- Grid Menu Produk -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% if (produk && produk.length> 0) { %>
                    <% produk.forEach(item=> { %>
                        <div
                            class="bg-white rounded-2xl shadow-sm border border-amber-100 overflow-hidden flex flex-col justify-between hover:shadow-md transition">
                            <div class="h-48 w-full bg-amber-100 overflow-hidden relative">
                                <img src="<%= item.gambar_url || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600' %>"
                                    alt="<%= item.nama_produk %>"
                                    class="w-full h-full object-cover hover:scale-105 transition duration-300"
                                    onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600';">
                                <div class="absolute top-3 right-3">
                                    <% if (item.stok> 0) { %>
                                        <span
                                            class="bg-emerald-600/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                                            Tersedia: <%= item.stok %> porsi
                                        </span>
                                        <% } else { %>
                                            <span
                                                class="bg-rose-600/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                                                Habis Terjual
                                            </span>
                                            <% } %>
                                </div>
                            </div>

                            <div class="p-5 flex-1 flex flex-col justify-between">
                                <div>
                                    <h4 class="text-lg font-bold text-gray-900 leading-snug">
                                        <%= item.nama_produk %>
                                    </h4>
                                    <p class="text-sm text-gray-600 mt-2 leading-relaxed line-clamp-2">
                                        <%= item.deskripsi || 'Menu racikan bumbu khas UMKM.' %>
                                    </p>
                                </div>
                                <div class="mt-4 font-black text-xl text-amber-700">
                                    <%= formatRupiah(item.harga) %>
                                </div>
                            </div>

                            <div class="p-4 bg-amber-50/50 border-t border-amber-100/60">
                                <% if (item.stok> 0) { %>
                                    <button type="button" data-id="<%= item.id %>" data-nama="<%= item.nama_produk %>"
                                        data-harga="<%= item.harga %>" data-stok="<%= item.stok %>"
                                        onclick="handleAddToCart(this)"
                                        class="w-full bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-white font-bold py-2.5 px-4 rounded-xl text-sm transition shadow-sm flex items-center justify-center gap-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none"
                                            viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                        </svg>
                                        + Tambah ke Pesanan
                                    </button>
                                    <% } else { %>
                                        <button disabled
                                            class="w-full bg-gray-200 text-gray-400 font-semibold py-2.5 px-4 rounded-xl text-sm cursor-not-allowed">
                                            Tutup Order (Porsi Habis)
                                        </button>
                                        <% } %>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div
                                    class="col-span-full py-16 text-center text-gray-400 bg-white rounded-3xl border border-dashed border-gray-300">
                                    Belum ada menu yang siap ditampilkan.
                                </div>
                                <% } %>
            </div>
        </main>

        <!-- Include Modals & Footer -->
        <%- include('components/modal-cart') %>
            <%- include('components/modal-ai') %>
                <%- include('components/footer') %>

                    <!-- External JS -->
                    <script src="/js/cart.js"></script>
</body>

</html>