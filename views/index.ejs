<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= appName %>
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-amber-50/40 text-gray-800 min-h-screen flex flex-col justify-between">

    <!-- Header Banner -->
    <header class="bg-amber-400 py-6 px-4 shadow-sm text-center">
        <h1 class="text-3xl font-extrabold text-amber-950 tracking-tight">
            <%= appName %>
        </h1>
        <p class="text-amber-900 font-medium text-sm mt-1">Sistem Pemesanan Sarapan & Katering Digital UMKM</p>
    </header>

    <!-- Konten Utama -->
    <main class="max-w-6xl mx-auto px-4 py-8 flex-1 w-full">

        <!-- Action Bar & Header Konten -->
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-900">Katalog Menu & Ketersediaan Stok</h2>
                <p class="text-sm text-gray-500">Ketersediaan porsi disinkronkan secara real-time dari database</p>
            </div>
            <!-- Tombol Trigger Tambah Produk (Operasi Create) -->
            <button onclick="openModalCreate()"
                class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 rounded-lg shadow-sm transition flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Tambah Menu Baru
            </button>
        </div>

        <!-- Grid Daftar Produk -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% if (produk && produk.length> 0) { %>
                <% produk.forEach(item=> { %>
                    <div
                        class="bg-white rounded-2xl shadow-sm border border-amber-100 overflow-hidden flex flex-col justify-between hover:shadow-md transition">

                        <!-- Banner Gambar Produk -->
                        <div class="h-44 w-full bg-amber-100 overflow-hidden relative">
                            <img src="<%= item.gambar_url || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500' %>"
                                alt="<%= item.nama_produk %>"
                                class="w-full h-full object-cover hover:scale-105 transition duration-300"
                                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500';">
                            <!-- Badge Stok Melayang di atas Gambar -->
                            <div class="absolute top-3 right-3">
                                <% if (item.stok> 0) { %>
                                    <span
                                        class="bg-emerald-600/90 backdrop-blur-sm text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                                        Sisa <%= item.stok %> porsi
                                    </span>
                                    <% } else { %>
                                        <span
                                            class="bg-rose-600/90 backdrop-blur-sm text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-sm">
                                            Stok Habis
                                        </span>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Detail Menu -->
                        <div class="p-5 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 leading-snug">
                                    <%= item.nama_produk %>
                                </h3>
                                <p class="text-sm text-gray-600 mt-2 line-clamp-2">
                                    <%= item.deskripsi || 'Menu lezat khas dapur UMKM.' %>
                                </p>
                            </div>
                            <div class="mt-4 font-black text-xl text-amber-700">
                                <%= formatRupiah(item.harga) %>
                            </div>
                        </div>

                        <!-- Aksi CRUD & Pesan -->
                        <div
                            class="bg-amber-50/50 border-t border-amber-100/60 p-4 flex items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <button
                                    onclick="openModalEdit('<%= item.id %>', '<%= item.nama_produk %>', '<%= item.harga %>', '<%= item.stok %>', `<%= item.deskripsi %>`, '<%= item.gambar_url || `` %>')"
                                    class="text-xs text-blue-600 hover:text-blue-800 font-semibold">
                                    Ubah
                                </button>
                                <span class="text-gray-300">|</span>
                                <button onclick="deleteProduct('<%= item.id %>')"
                                    class="text-xs text-rose-600 hover:text-rose-800 font-semibold">
                                    Hapus
                                </button>
                            </div>

                            <% if (item.stok> 0) { %>
                                <button onclick="orderProduct('<%= item.nama_produk %>')"
                                    class="bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold px-3.5 py-2 rounded-lg transition shadow-sm">
                                    + Pesan Porsi
                                </button>
                                <% } else { %>
                                    <button disabled
                                        class="bg-gray-200 text-gray-400 text-xs font-medium px-3.5 py-2 rounded-lg cursor-not-allowed">
                                        Habis
                                    </button>
                                    <% } %>
                        </div>

                    </div>
                    <% }) %>
                        <% } else { %>
                            <div
                                class="col-span-full py-16 text-center text-gray-500 bg-white rounded-2xl border border-dashed border-gray-300">
                                Belum ada menu yang tersedia di database.
                            </div>
                            <% } %>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 py-6 text-center text-xs text-gray-500">
        &copy; 2026 <%= appName %> &bull; Praktikum Pengembangan Aplikasi Web (Topic 8)
    </footer>

    <!-- MODAL CREATE & UPDATE -->
    <div id="productModal"
        class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 id="modalTitle" class="text-lg font-bold text-gray-900">Form Menu</h3>
                <button onclick="closeModal()"
                    class="text-gray-400 hover:text-gray-600 text-2xl font-bold">&times;</button>
            </div>

            <form id="productForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
                <input type="hidden" id="formId">

                <div>
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Nama Menu</label>
                    <input type="text" id="formNama" required
                        class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                        placeholder="misal: Nasi Kuning Ayam Bakar">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Harga (Rp)</label>
                        <input type="number" id="formHarga" required min="1000"
                            class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                            placeholder="15000">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Stok Porsi</label>
                        <input type="number" id="formStok" required min="0"
                            class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                            placeholder="20">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">URL Gambar Produk</label>
                    <input type="url" id="formGambar"
                        class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                        placeholder="https://images.unsplash.com/photo-...">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-gray-700 uppercase mb-1">Deskripsi Porsi /
                        Lauk</label>
                    <textarea id="formDeskripsi" rows="3"
                        class="w-full border border-gray-300 px-3 py-2 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
                        placeholder="Detail lauk pauk..."></textarea>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t">
                    <button type="button" onclick="closeModal()"
                        class="px-4 py-2 border border-gray-300 rounded-lg text-sm text-gray-700 hover:bg-gray-50">Batal</button>
                    <button type="submit"
                        class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-lg text-sm font-semibold shadow-sm">Simpan
                        Data</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Client-Side JavaScript untuk CRUD Fetch API -->
    <script>
        const modal = document.getElementById('productModal');
        const modalTitle = document.getElementById('modalTitle');
        const formId = document.getElementById('formId');
        const formNama = document.getElementById('formNama');
        const formHarga = document.getElementById('formHarga');
        const formStok = document.getElementById('formStok');
        const formDeskripsi = document.getElementById('formDeskripsi');
        const formGambar = document.getElementById('formGambar');

        function openModalCreate() {
            modalTitle.innerText = 'Tambah Menu Baru';
            formId.value = '';
            formNama.value = '';
            formHarga.value = '';
            formStok.value = '';
            formDeskripsi.value = '';
            formGambar.value = '';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function openModalEdit(id, nama, harga, stok, deskripsi, gambar) {
            modalTitle.innerText = 'Ubah Rincian Menu';
            formId.value = id;
            formNama.value = nama;
            formHarga.value = harga;
            formStok.value = stok;
            formDeskripsi.value = deskripsi;
            formGambar.value = gambar || '';
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeModal() {
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        async function handleFormSubmit(e) {
            e.preventDefault();
            const id = formId.value;
            const data = {
                nama_produk: formNama.value,
                harga: parseInt(formHarga.value),
                stok: parseInt(formStok.value),
                deskripsi: formDeskripsi.value,
                gambar_url: formGambar.value || null
            };

            const url = id ? `/api/produk/${id}` : '/api/produk';
            const method = id ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                if (res.ok) {
                    window.location.reload();
                } else {
                    const err = await res.json();
                    alert('Gagal: ' + (err.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                alert('Gagal menghubungi server');
            }
        }

        async function deleteProduct(id) {
            if (!confirm('Yakin ingin menghapus menu ini dari database?')) return;

            try {
                const res = await fetch(`/api/produk/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    window.location.reload();
                } else {
                    alert('Gagal menghapus produk');
                }
            } catch (err) {
                alert('Gagal menghubungi server');
            }
        }

        function orderProduct(nama) {
            alert(`Pesanan [${nama}] berhasil dipilih!`);
        }
    </script>

</body>

</html>